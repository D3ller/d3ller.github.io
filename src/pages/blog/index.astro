---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog">
	<a href="/" class="text-sm text-muted underline underline-offset-4 hover:text-black">cd ..</a>

	<h1 class="text-xl font-semibold mt-8 mb-4">Blog</h1>

	{posts.length > 0 ? (
		<ul>
			{posts.map((post) => (
				<li class="mb-2 flex justify-between gap-4">
					<a class="underline underline-offset-4 lowercase" href={`/blog/${post.id}/`}>
						{post.data.title}
					</a>
					<span class="text-sm text-muted shrink-0">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</li>
			))}
		</ul>
	) : (
		<p class="text-sm text-muted">No posts yet.</p>
	)}
</Layout>
