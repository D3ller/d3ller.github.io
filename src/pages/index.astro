---
import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";

const projects = (await getCollection("project")).sort(
    (a, b) => b.data.startedDate.valueOf() - a.data.startedDate.valueOf(),
);

const blogs = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout>
    <div class="flex flex-col gap-4">
        <img
            class="size-20 rounded-lg before:content-['']"
            src="/src/assets/profile-picture.jpeg"
        />

        <div>
            <h1 class="text-xl font-semibold">d3ller</h1>

            <p class="text-muted text-sm">
                French developer from Bordeaux who enjoys building software and websites, and sometimes Minecraft plugins.
            </p>
        </div>
    </div>

    <div class="grid gap-16 md:gap-0 md:grid-cols-2 mt-8">
        <div>
            <h2 class="text-muted mb-4">Projects</h2>
            {projects.length > 0 ? (
                <ul>
                    {projects.map((project) => (
                        <li class="mb-2">
                            <a class="underline underline-offset-4" href={`/project/${project.id}/`}>
                                {project.data.title}
                            </a>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="text-sm text-muted">No projects yet.</p>
            )}
        </div>

        <div>
            <h2 class="text-muted mb-4">Blog</h2>
            {blogs.length > 0 ? (
                <ul>
                    {blogs.map((post) => (
                        <li class="mb-2">
                            <a class="underline underline-offset-4 lowercase" href={`/blog/${post.id}/`}>
                                {post.data.title}
                            </a>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="text-sm text-muted">No posts yet.</p>
            )}
        </div>
    </div>
</Layout>
